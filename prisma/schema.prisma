// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cidade {
  id  Int @id
  nome  String
  uf  String
  geometria Unsupported("geometry")
  pontos Ponto[]
  linhas  Linha[]
  enquadramentoMapa Unsupported("box2d") @map("enquadramento_mapa")

  @@map("cidade")
}

model Ponto {
  id  Int @id @default(autoincrement())
  logradouro  String
  numero  String @default("S/N")
  cidade  Cidade  @relation(fields: [cidade_id], references: [id])
  cidade_id Int @map("cidade")
  coordenada Unsupported("geometry")
  trajetos  PontoTrajeto[]

  @@map("ponto")
}

model Linha {
  id  Int @id @default(autoincrement())
  codigo  Int @unique
  nome  String
  cidade  Cidade @relation(fields: [cidade_id], references: [id])
  cidade_id Int @map("cidade")
  trajetos  Trajeto[]

  @@map("linha")
}

model Trajeto {
  id  Int @id @default(autoincrement())
  ativo Boolean
  vigencia  DateTime?
  geometria Unsupported("geometry")
  linha Linha @relation(fields:[linha_id], references: [id])
  linha_id  Int @map("linha")
  updated_at  DateTime @default(now())
  pontos  PontoTrajeto[]

  @@map("trajeto")
}

model PontoTrajeto{
  id  Int @id @default(autoincrement())
  ordem Int
  final Boolean
  ponto Ponto @relation(fields:[ponto_id], references: [id])
  ponto_id  Int @map("ponto")
  trajeto Trajeto @relation(fields:[trajeto_id], references: [id], onDelete: Cascade)
  trajeto_id  Int @map("trajeto")

  @@map("ponto_trajeto")
}