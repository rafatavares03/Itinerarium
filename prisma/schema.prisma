// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cidade {
  id  Int @id
  nome  String
  uf  String
  geometria Unsupported("geometry")
  pontos Ponto[]
  linhas  Linha[]
  enquadramentoMapa Unsupported("box2d") @map("enquadramento_mapa")
  administradores User[]

  @@map("cidade")
}

model Ponto {
  id  Int @id @default(autoincrement())
  logradouro  String
  numero  String @default("S/N")
  cidade  Cidade  @relation(fields: [cidade_id], references: [id])
  cidade_id Int @map("cidade")
  coordenada Unsupported("geometry")
  trajetos  PontoTrajeto[]

  @@map("ponto")
}

model Linha {
  id  Int @id @default(autoincrement())
  codigo  String
  origem  String
  destino String
  cidade  Cidade @relation(fields: [cidade_id], references: [id])
  cidade_id Int @map("cidade")
  trajetos  Trajeto[]
  horarios  Horario[]
  comentarios Comentario[]

  @@unique([cidade_id, codigo])
  @@map("linha")
}

model Trajeto {
  id  Int @id @default(autoincrement())
  ativo Boolean
  vigencia  DateTime?
  geometria Unsupported("geometry")
  ida Boolean
  linha Linha @relation(fields:[linha_id], references: [id])
  linha_id  Int @map("linha")
  updated_at  DateTime @default(now())
  pontos  PontoTrajeto[]

  @@map("trajeto")
}

model PontoTrajeto {
  id  Int @id @default(autoincrement())
  ordem Int
  final Boolean
  ponto Ponto @relation(fields:[ponto_id], references: [id])
  ponto_id  Int @map("ponto")
  trajeto Trajeto @relation(fields:[trajeto_id], references: [id], onDelete: Cascade)
  trajeto_id  Int @map("trajeto")

  @@map("ponto_trajeto")
}

model Horario {
  hora DateTime
  ida Boolean
  linha Linha @relation(fields:[linha_id], references: [id])
  linha_id Int @map("linha")

  @@id([hora, ida, linha_id])
  @@map("horario")
} 

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  role          String          @default("USER")
  password      String
  accounts      Account[]
  sessions      Session[]
  city          Cidade?         @relation(fields:[city_id], references: [id])
  city_id       Int?            @map("cidade")
  comentarios   Comentario[]

  createdAt DateTime @default(now())  @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")

  @@map("usuario")
}
 
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
  @@map("conta")
}
 
model Session {
  sessionToken String   @unique
  userId       String   @map("usuario")
  expires      DateTime @map("expires_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessao")
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
  @@map("token_verificacao")
}

model Comentario {
  id String @id @default(cuid())
  texto String
  linha Linha @relation(fields:[linha_id], references: [id])
  linha_id Int @map("linha")
  usuario User @relation(fields: [usuario_id], references: [id])
  usuario_id String @map("usuario")
  created_at DateTime @default(now())

  @@map("comentario")
}